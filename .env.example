# Public values embedded in the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only values; never prefix these with VITE_
SUPABASE_URL=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:5173

# Set true only after production authentication email delivery is verified
AUTH_EMAIL_READY=false
# Set true only after the Google provider succeeds end to end in production
GOOGLE_LOGIN_READY=false

# Local Supabase Google provider values; keep the secret out of source control
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
